<Window x:Class="ModelMerger.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ModelMerger.Gui.ViewModels"
        xmlns:loc="clr-namespace:ModelMerger.Gui.Localization"
        mc:Ignorable="d"
        Title="{Binding [AppTitle], Source={x:Static loc:LanguageCatalog.Current}}"
        Width="1280"
        Height="900"
        MinWidth="1000"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        FontSize="14"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="ForegroundBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="MutedForegroundBrush" Color="#64748B" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE4EF" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0F172A" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4,16,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="Expander">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>

    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding [AppTitle], Source={x:Static loc:LanguageCatalog.Current}}" FontSize="28" FontWeight="Bold" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding [AppSubtitle], Source={x:Static loc:LanguageCatalog.Current}}"
                           Foreground="{StaticResource MutedForegroundBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Language], Source={x:Static loc:LanguageCatalog.Current}}"
                               FontSize="11"
                               Foreground="{StaticResource MutedForegroundBrush}" />
                    <ComboBox MinWidth="92"
                              ItemsSource="{Binding LanguageOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}" />
                </StackPanel>
                <Button Content="{Binding [NewGroup], Source={x:Static loc:LanguageCatalog.Current}}"
                        Margin="0,0,8,0"
                        Command="{Binding AddGroupCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="{Binding [SaveSettings], Source={x:Static loc:LanguageCatalog.Current}}"
                        Margin="0,0,8,0"
                        Click="SaveSettings_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="{Binding [RestoreDefaults], Source={x:Static loc:LanguageCatalog.Current}}"
                        Command="{Binding RestoreDefaultsCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MergeGroupViewModel}">
                        <Border Margin="0,0,0,14"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                AllowDrop="True"
                                DragOver="Group_DragOver"
                                Drop="Group_Drop">
                            <Expander IsExpanded="{Binding IsExpanded}">
                                <Expander.Header>
                                    <Grid Margin="12,8,12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                                            <Border Margin="10,0,0,0" Padding="9,4" CornerRadius="10" Background="#DBEAFE">
                                                <TextBlock Text="{Binding PartCountText}" FontSize="12" Foreground="#1D4ED8" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SummaryText}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedForegroundBrush}" />
                                        <Button Grid.Column="3"
                                                Content="{Binding [StartGroup], Source={x:Static loc:LanguageCatalog.Current}}"
                                                Command="{Binding MergeCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Grid.Column="5"
                                                Content="{Binding [Cancel], Source={x:Static loc:LanguageCatalog.Current}}"
                                                Command="{Binding CancelCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Grid.Column="7"
                                                Content="{Binding [DeleteGroup], Source={x:Static loc:LanguageCatalog.Current}}"
                                                Foreground="#B91C1C"
                                                Command="{Binding DataContext.RemoveGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>
                                </Expander.Header>

                                <Grid Margin="18,0,18,18" Height="565">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="560" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="340" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource SectionCardStyle}"
                                            Background="#F8FAFC"
                                            IsEnabled="{Binding IsEditable}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding [ModelParts], Source={x:Static loc:LanguageCatalog.Current}}" FontSize="16" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding [ModelPartsHint], Source={x:Static loc:LanguageCatalog.Current}}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource MutedForegroundBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="{Binding [AddNext], Source={x:Static loc:LanguageCatalog.Current}}"
                                                        Command="{Binding AddNextCommand}"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Grid.Column="3"
                                                        Content="{Binding [Clear], Source={x:Static loc:LanguageCatalog.Current}}"
                                                        Command="{Binding ClearCommand}"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                            </Grid>

                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Slots}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="4" Rows="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:PartSlotViewModel}">
                                                        <Border x:Name="SlotBorder"
                                                                Margin="4"
                                                                Background="White"
                                                                BorderBrush="#CBD5E1"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                ToolTip="{Binding FilePath}">
                                                            <Grid Margin="9,7">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="*" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid>
                                                                    <Border HorizontalAlignment="Left" Padding="6,2" CornerRadius="7" Background="#E2E8F0">
                                                                        <TextBlock Text="{Binding NumberText}" FontSize="10" Foreground="#475569" />
                                                                    </Border>
                                                                    <Border x:Name="RootBadge"
                                                                            HorizontalAlignment="Right"
                                                                            Padding="6,2"
                                                                            CornerRadius="7"
                                                                            Background="#FEF3C7"
                                                                            Visibility="Collapsed">
                                                                        <TextBlock Text="{Binding [RootBadge], Source={x:Static loc:LanguageCatalog.Current}}" FontSize="10" Foreground="#92400E" />
                                                                    </Border>
                                                                </Grid>
                                                                <Button Grid.Row="1"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand"
                                                                        Command="{Binding DataContext.AddOrReplaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        AutomationProperties.Name="{Binding AccessibleName}">
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock x:Name="AddGlyph"
                                                                                   Text="＋"
                                                                                   HorizontalAlignment="Center"
                                                                                   FontSize="18"
                                                                                   Foreground="#64748B" />
                                                                        <TextBlock Text="{Binding FileName}"
                                                                                   TextAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   FontWeight="SemiBold"
                                                                                   FontSize="12" />
                                                                        <TextBlock x:Name="DirectoryText"
                                                                                   Text="{Binding DirectoryName}"
                                                                                   TextAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   FontSize="10"
                                                                                   Foreground="{StaticResource MutedForegroundBrush}" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <StackPanel x:Name="SlotActions"
                                                                            Grid.Row="2"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Center"
                                                                            Visibility="Collapsed">
                                                                    <Button Content="{Binding [SetAsRoot], Source={x:Static loc:LanguageCatalog.Current}}"
                                                                            Command="{Binding DataContext.SetManualRootCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Style="{StaticResource LinkButtonStyle}"
                                                                            FontSize="10"
                                                                            Foreground="#B45309" />
                                                                    <Button Content="{Binding [Remove], Source={x:Static loc:LanguageCatalog.Current}}"
                                                                            Command="{Binding DataContext.RemovePartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Style="{StaticResource LinkButtonStyle}"
                                                                            FontSize="10"
                                                                            Foreground="#B91C1C" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                                                <Setter TargetName="SlotBorder" Property="Background" Value="#EFF6FF" />
                                                                <Setter TargetName="SlotBorder" Property="BorderBrush" Value="#93C5FD" />
                                                                <Setter TargetName="AddGlyph" Property="Visibility" Value="Collapsed" />
                                                                <Setter TargetName="SlotActions" Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsManualRoot}" Value="True">
                                                                <Setter TargetName="RootBadge" Property="Visibility" Value="Visible" />
                                                                <Setter TargetName="SlotBorder" Property="BorderBrush" Value="#D97706" />
                                                                <Setter TargetName="SlotBorder" Property="BorderThickness" Value="2" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <Border Style="{StaticResource SectionCardStyle}"
                                                    Margin="0,0,0,12"
                                                    IsEnabled="{Binding IsEditable}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding [GroupSettings], Source={x:Static loc:LanguageCatalog.Current}}" FontSize="16" FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,12,0,4" Text="{Binding [RootModel], Source={x:Static loc:LanguageCatalog.Current}}" FontWeight="SemiBold" />
                                                    <WrapPanel>
                                                        <RadioButton Content="{Binding [Automatic], Source={x:Static loc:LanguageCatalog.Current}}" IsChecked="{Binding IsAutomaticRoot}" />
                                                        <RadioButton Content="{Binding [Manual], Source={x:Static loc:LanguageCatalog.Current}}" IsChecked="{Binding IsManualRootMode}" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding [ManualRootHint], Source={x:Static loc:LanguageCatalog.Current}}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource MutedForegroundBrush}" />
                                                    <TextBlock Margin="0,12,0,4" Text="{Binding [OutputFolder], Source={x:Static loc:LanguageCatalog.Current}}" FontWeight="SemiBold" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="7" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.Name="{Binding [OutputFolder], Source={x:Static loc:LanguageCatalog.Current}}"
                                                                 AutomationProperties.HelpText="{Binding [OutputFolderHelp], Source={x:Static loc:LanguageCatalog.Current}}" />
                                                        <Button Grid.Column="2"
                                                                Content="{Binding [Browse], Source={x:Static loc:LanguageCatalog.Current}}"
                                                                Command="{Binding BrowseOutputCommand}"
                                                                Style="{StaticResource SecondaryButtonStyle}" />
                                                    </Grid>
                                                    <TextBlock Margin="0,12,0,4" Text="{Binding [OutputFileNameOptional], Source={x:Static loc:LanguageCatalog.Current}}" FontWeight="SemiBold" />
                                                    <TextBox Text="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="{Binding [OutputFileNameOptional], Source={x:Static loc:LanguageCatalog.Current}}"
                                                             AutomationProperties.HelpText="{Binding [OutputFileNameHelp], Source={x:Static loc:LanguageCatalog.Current}}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Text="{Binding [OutputFileHint], Source={x:Static loc:LanguageCatalog.Current}}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource MutedForegroundBrush}" />
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource SectionCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding [GroupStatus], Source={x:Static loc:LanguageCatalog.Current}}" FontSize="16" FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,9,0,7"
                                                               Text="{Binding StatusMessage}"
                                                               TextWrapping="Wrap"
                                                               AutomationProperties.LiveSetting="Polite" />
                                                    <ProgressBar Height="8"
                                                                 Minimum="0"
                                                                 Maximum="100"
                                                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                                                 Foreground="{StaticResource PrimaryBrush}"
                                                                 Background="#E2E8F0" />
                                                    <Expander Margin="0,9,0,0" Header="{Binding [RunLog], Source={x:Static loc:LanguageCatalog.Current}}">
                                                        <TextBox Margin="0,7,0,0"
                                                                 Height="86"
                                                                 Text="{Binding LogText, Mode=OneWay}"
                                                                 IsReadOnly="True"
                                                                 AcceptsReturn="True"
                                                                 VerticalScrollBarVisibility="Auto"
                                                                 HorizontalScrollBarVisibility="Auto"
                                                                 FontFamily="Consolas"
                                                                 FontSize="11" />
                                                    </Expander>
                                                    <Button Margin="0,9,0,0"
                                                            Content="{Binding [OpenGroupOutput], Source={x:Static loc:LanguageCatalog.Current}}"
                                                            Command="{Binding OpenOutputCommand}"
                                                            Style="{StaticResource SecondaryButtonStyle}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding WorkspaceStatus}" AutomationProperties.LiveSetting="Polite" />
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="{Binding ConcurrencyText}" FontSize="12" Foreground="{StaticResource MutedForegroundBrush}" />
                    <TextBlock Text="{Binding [Attribution], Source={x:Static loc:LanguageCatalog.Current}}"
                               FontSize="12"
                               Foreground="{StaticResource MutedForegroundBrush}" />
                </StackPanel>
            </StackPanel>
            <CheckBox Grid.Column="1"
                      Content="{Binding [RememberOutput], Source={x:Static loc:LanguageCatalog.Current}}"
                      IsChecked="{Binding RememberOutputDirectory}"
                      VerticalAlignment="Center"
                      ToolTip="{Binding [RememberOutputHint], Source={x:Static loc:LanguageCatalog.Current}}" />
            <Button Grid.Column="3"
                    Content="{Binding [CancelAll], Source={x:Static loc:LanguageCatalog.Current}}"
                    Command="{Binding CancelAllCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="5"
                    MinWidth="210"
                    Content="{Binding [MergeAllReady], Source={x:Static loc:LanguageCatalog.Current}}"
                    Command="{Binding MergeAllCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
