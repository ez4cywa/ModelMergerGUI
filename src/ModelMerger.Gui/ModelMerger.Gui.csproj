<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CastModelMerger</AssemblyName>
    <RootNamespace>ModelMerger.Gui</RootNamespace>
    <ApplicationIcon>..\ModelMerger\icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Version>1.2.1</Version>
    <Product>Cast Model Merger GUI</Product>
    <Description>Merge 2 to 15 Cast model parts with a visual Windows interface.</Description>
    <Company>ModelMerger contributors</Company>
    <DebugType Condition="'$(Configuration)' == 'Release'">None</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions Condition="'$(Configuration)' == 'Release'"></AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModelMerger.Core\ModelMerger.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Fonts\MiSans-Medium.ttf" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets\Fonts\MiSans-License.pdf" CopyToPublishDirectory="PreserveNewest" TargetPath="MiSans-License.pdf" />
  </ItemGroup>

  <Target Name="BuildRustMergeWorker" BeforeTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <Exec
      WorkingDirectory="$(MSBuildProjectDirectory)\..\..\rust"
      Command="cargo build --release --locked -p model-merger-worker" />
  </Target>

  <Target Name="CopyRustMergeWorker" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\..\..\rust\target\release\model-merger-worker.exe"
      DestinationFiles="$(PublishDir)model-merger-worker.exe" />
  </Target>
</Project>
